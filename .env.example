# Carnet environment (keys only; values go in .env, never here)

# Airwallex sandbox (never production keys)
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_FILES_URL=https://files.sandbox.airwallex.com
AIRWALLEX_WEBHOOK_SECRET=

# Anthropic API (first-party key from the Claude Console organisation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_EXTRACT=claude-haiku-5-5
ANTHROPIC_MODEL_DRAFT=claude-sonnet-5-5

# Database (plain PostgreSQL connection strings; roles from packages/db/sql/roles.sql)
# DATABASE_URL: the app role (carnet_app, DML only). Local shape: postgres://carnet_app:<pw>@localhost:5432/carnet
# DATABASE_MIGRATION_URL: the migration role (carnet_migrator, owns the schema; npm run db:migrate)
DATABASE_URL=
DATABASE_MIGRATION_URL=
TEST_DATABASE_URL=

# App
APP_BASE_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info
PROCESS_MODE=web

# Worker and API limits
WORKER_POLL_MS=1000
OUTBOX_MAX_ATTEMPTS=8
MAX_JSON_BODY_BYTES=1048576
RATE_LIMIT_WEBHOOK_PER_MIN=600
# Proxies in front of the app that append to X-Forwarded-For (per-IP rate limits use the entry the
# outermost one appended). Verify on the deployed platform (M1-06).
TRUSTED_PROXY_HOPS=1
APPROVAL_TTL_MINUTES=30

# Uploads (M2-01). UPLOAD_MAX_BYTES caps the upload request body (default 5 MiB, never above 5 MiB);
# the session caps are per session per hour and also apply to the judge login.
UPLOAD_SESSION_MAX_FILES=10
UPLOAD_SESSION_MAX_BYTES=26214400

# Payee status page
PAYEE_LINK_TTL_HOURS=72
PAYEE_STATUS_RATE_LIMIT_PER_MIN=30

# Seeded demo logins (synthetic; set per environment, never committed)
SEED_OWNER_PASSWORD=
SEED_APPROVER_PASSWORD=
SEED_JUDGE_PASSWORD=

# Limits and controls (defaults in code; override per environment)
UPLOAD_MAX_BYTES=5242880
MODEL_DAILY_SPEND_CAP_USD=10
MODEL_PER_RUN_CAP_USD=1
AGENTS_ENABLED=true
EXECUTION_ENABLED=true
EVAL_SPEND_CAP_USD=2
SESSION_MODEL_CAP_USD=0.5

# Operations
OPS_CHECK_TOKEN=
JUDGE_REPLAY_ENABLED=false

# Gates, end-to-end runs and submission checks (set only when running them)
DEPLOY_URL=
E2E_BASE_URL=
E2E_MODE=
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
VIDEO_URL=
REPO_URL=
