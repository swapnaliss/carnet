exports[`renderStatusPage > matches the recorded snapshot (no amount, currency, name, reference, bank detail, ids) 1`] = `
"<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<title>Payment status</title><style>:root{color-scheme:light dark;--bg:#fbfaf7;--fg:#1c1f24;--card:#fff;--muted:#585d66;--border:#868b94;--progress-fg:#1a4f8b;--progress-bg:#e3edf8;--success-fg:#1d6b4f;--success-bg:#e2f2ea;--danger-fg:#a1261b;--danger-bg:#fbe6e3;--warning-fg:#7f4500;--warning-bg:#fcefd9}@media (prefers-color-scheme:dark){:root{--bg:#12151a;--fg:#e7e9ec;--card:#1a1e24;--muted:#a3a9b2;--border:#737a85;--progress-fg:#9cc4f2;--progress-bg:#16263b;--success-fg:#7fd3ae;--success-bg:#12291f;--danger-fg:#f4a097;--danger-bg:#33171a;--warning-fg:#f2c46b;--warning-bg:#2e2210}}*{box-sizing:border-box}body{margin:0;min-height:100dvh;background:var(--bg);color:var(--fg);font:16px/1.5 "IBM Plex Sans","Segoe UI",system-ui,-apple-system,"Noto Sans",sans-serif}main{max-width:32rem;margin:0 auto;padding:2.5rem 1rem}.card{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:1.5rem}h1{margin:0 0 1rem;font-size:1.375rem;line-height:1.25;font-weight:600}dl{margin:0}dt{color:var(--muted);font-size:.875rem}dd{margin:.25rem 0 1rem}.word{display:inline-block;padding:.25rem .75rem;border-radius:6px;font-weight:600}.progress{background:var(--progress-bg);color:var(--progress-fg)}.success{background:var(--success-bg);color:var(--success-fg)}.danger{background:var(--danger-bg);color:var(--danger-fg)}.warning{background:var(--warning-bg);color:var(--warning-fg)}p{margin:0 0 .75rem}.note{color:var(--muted);font-size:.875rem;margin:1rem 0 0}.notice{display:block;margin:0 0 1rem}@media (min-width:768px){h1{font-size:1.75rem}main{padding-top:4rem}}</style></head>
<body><main id="main"><div class="card"><h1>Payment status</h1>
<dl><dt>Status</dt>
<dd><span class="word progress">Processing</span></dd>
<dt>Last updated</dt>
<dd><time datetime="2026-11-06T14:03:00.000Z">6 Nov 2026, 14:03 UTC</time></dd></dl>
<p class="note">This page shows the latest status reported for one payment. It is read-only.</p></div></main></body></html>"
`;

